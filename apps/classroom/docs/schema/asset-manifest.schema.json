{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+_[a-z0-9-]+_(character|object|background|icon|overlay|audio)_[a-z0-9-]+_v\\d{2}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "character",
              "object",
              "background",
              "icon",
              "overlay",
              "audio"
            ]
          },
          "file": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "promptId": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "placeholder",
              "generated",
              "approved"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^v\\d{2}$"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "assets"
  ],
  "additionalProperties": false
}
