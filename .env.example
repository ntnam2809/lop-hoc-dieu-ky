# Mẫu biến môi trường — KHÔNG điền giá trị thật vào file này, không commit .env.
# Dùng cho apps/server (ADR-0004/0011). MVP dùng Firebase Auth + Firestore (ADR-0017); Postgres hoãn.

# Server
PORT=2567
NODE_ENV=development
# Nguồn gốc client được phép (CORS/WebSocket), phân tách bằng dấu phẩy. Bắt buộc khi production.
ALLOWED_ORIGINS=http://localhost:5180

# Lưu trữ: memory (dev/test) | firestore (production bắt buộc)
STORE=memory
# Xác thực: dev | firebase. Mặc định firebase trừ NODE_ENV=test; dev phải đặt rõ (và chỉ với STORE=memory hoặc Firestore emulator)
AUTH_MODE=dev
# Bắt buộc khi STORE=firestore hoặc AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
# uid được phép đăng ký người lớn mới, phân tách bằng dấu phẩy
SIGNUP_ALLOWLIST=

# Giới hạn kích thước
WS_MAX_PAYLOAD_BYTES=4096
HTTP_MAX_BODY_BYTES=16384

# Credential Firebase: dùng Application Default Credentials qua GOOGLE_APPLICATION_CREDENTIALS
# trỏ tới file NGOÀI repo (service-account*.json đã gitignore). Secret đặt ở nền tảng host, không ghi vào đây.
# GOOGLE_APPLICATION_CREDENTIALS=
# Emulator (chỉ local): FIRESTORE_EMULATOR_HOST, FIREBASE_AUTH_EMULATOR_HOST
# FIRESTORE_EMULATOR_HOST=
# FIREBASE_AUTH_EMULATOR_HOST=

# Chỉ để đo tải/chẩn đoán, không dùng cho vận hành
# CAMPUS_MAX_CLIENTS=
# CAMPUS_LOG_CORRECT=

# Engine bài học: xem apps/classroom/.env.example (VITE_CONTENT_SOURCE, VITE_FIREBASE_*)
