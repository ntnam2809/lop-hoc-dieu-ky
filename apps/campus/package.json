{
  "name": "@lhdk/campus",
  "private": true,
  "version": "0.1.0",
  "description": "Client thế giới 2D (Phaser) của Lớp Học Diệu Kỳ.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5198 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "measure": "tsx tools/measure.ts",
    "dev:demo": "vite --port 5198 --strictPort --open /demo.html",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.42",
    "@colyseus/sdk": "0.18.6",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
