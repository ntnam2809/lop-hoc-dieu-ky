# Mẫu biến môi trường — KHÔNG điền giá trị thật vào file này, không commit .env.
# M0 chưa có server; các biến dưới đây là chỗ giữ cho M2 (apps/server, ADR-0004/0011).

# Server
PORT=2567
NODE_ENV=development
# Postgres (M2) — local: docker compose; staging/prod: do nền tảng host cấp
DATABASE_URL=postgres://lhdk:lhdk@localhost:5432/lhdk
# Nguồn gốc client được phép (CORS/WebSocket)
ALLOWED_ORIGINS=http://localhost:5180

# Engine bài học: xem apps/classroom/.env.example (VITE_CONTENT_SOURCE, VITE_FIREBASE_*)
