  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.6",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "ws": "8.22.0"
  }
}
